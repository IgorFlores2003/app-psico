{
  "name": "prontuario-psicologia",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:back": "npm run dev --prefix backend",
    "dev:front": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACK,FRONT\" -c \"cyan,magenta\" \"npm run dev:back\" \"npm run dev:front\"",
    "build:back": "npm run build --prefix backend",
    "build:front": "npm run build --prefix frontend",
    "build": "npm run build:back && npm run build:front",
    "seed": "npm run seed --prefix backend",
    "create-user": "npm run create-user --prefix backend",
    "migrate": "npm run migrate --prefix backend"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.1",
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  }
}
